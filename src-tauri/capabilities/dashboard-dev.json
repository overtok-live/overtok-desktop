{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-dev",
  "description": "Overtok Dev: the dev dashboard and a local one, with the same few things.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://app.dev.overtok.live/*", "http://localhost:3000/*"]
  },
  "permissions": [
    "allow-app-info",
    "allow-begin-sign-in",
    "allow-open-external",
    "allow-set-live",
    "allow-update-state",
    "allow-install-update",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-obs-open",
    "allow-obs-send",
    "allow-obs-close",
    "allow-obs-settings",
    "allow-sound-window",
    "allow-sound-window-on",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
